{
  "name": "monay-market-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Caja (POS) de Monay Market: app Android del cajero (Capacitor) que carga la caja servida por la API en /pos/.",
  "scripts": {
    "vendor:sync": "cp node_modules/@capacitor/core/dist/capacitor.js src/vendor/capacitor-core.js && cp node_modules/@capacitor-community/bluetooth-le/dist/plugin.js src/vendor/capacitor-bluetooth-le.js",
    "cap:sync": "npm run vendor:sync && node sync-version.mjs && cap sync android",
    "cap:open:android": "cap open android"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
