<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Escáner de códigos de barras de la caja. Capacitor solo entrega la
         cámara al WebView si la app declara este permiso; Android lo pide la
         primera vez que se abre el escáner. required="false": la app se puede
         instalar en equipos sin cámara (el código se escribe en el buscador). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Impresora Bluetooth. La app no usa el Bluetooth para ubicar a nadie
         (neverForLocation): en Android 12+ solo pide "Dispositivos cercanos",
         sin ubicación. En Android 11 (el mínimo de la app) Android sí exige la
         ubicación para buscar Bluetooth, por eso se mantiene hasta la API 30.
         Va junto con initialize({ androidNeverForLocation: true }) en printer.js. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Para el cobro con tarjeta vía SumUp Tap to Pay (SDK nativo, pendiente
         de acceso de SumUp). required="false" porque hoy la app también se
         usa solo para pagar en efectivo, sin NFC: así no se bloquea la
         instalación en celulares sin NFC. Cuando se integre el SDK, revisar
         si conviene pasar a required="true" según cómo se distribuya. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
</manifest>
