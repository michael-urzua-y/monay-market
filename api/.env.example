# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=monay_market
DB_PASSWORD=replace-with-the-same-password-from-postgres-env
DB_DATABASE=monay_market

# JWT
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRATION=12h

# SII provider credentials
# Required only when using these providers outside mocked/test API keys.
SII_SIMPLEAPI_RUT=
SII_SIMPLEAPI_PASSWORD=
SII_BASEAPI_RUT=
SII_BASEAPI_PASSWORD=
SII_BASEAPI_CERT_PASSWORD=

# App
PORT=3000
NODE_ENV=production
PWA_PATH=/app/pwa
CORS_ORIGIN=http://localhost:3000,http://localhost:5000
WS_CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Optional development seed data. If omitted, migrations generate a temporary password.
# SEED_PASSWORD=
