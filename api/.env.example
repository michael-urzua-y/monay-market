# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=monay_market
DB_PASSWORD=replace-with-the-same-password-from-postgres-env
DB_DATABASE=monay_market

# JWT
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRATION=12h
APP_DATA_ENCRYPTION_KEY=replace-with-a-different-32-plus-char-secret-for-data-encryption

# SII provider credentials
# Required only when using these providers outside mocked/test API keys.
SII_SIMPLEAPI_RUT=
SII_SIMPLEAPI_PASSWORD=
SII_BASEAPI_RUT=
SII_BASEAPI_PASSWORD=
SII_BASEAPI_CERT_PASSWORD=
SII_APIGATEWAY_BASE_URL=https://app.apigateway.cl/api/v2

# App
PORT=3000
NODE_ENV=production
PWA_PATH=/app/pwa
STRICT_ENV_VALIDATION=false
RUN_MIGRATIONS=true
CORS_ORIGIN=http://localhost:8080
WS_CORS_ORIGIN=http://localhost:8080

# Opcional: URL de Redis para escalar WebSocket a múltiples réplicas del API.
# Déjala vacía para una sola instancia (usa el adapter en memoria por defecto).
# Ejemplo: redis://redis:6379
WS_REDIS_URL=

# Optional runtime config exposed to the PWA through /runtime-config.js.
# Leave empty in production when the PWA, login, and API share the same public domain.
PWA_API_URL=
PWA_LOGIN_URL=

# Optional barcode lookup providers. Override only if you need a private proxy or different endpoints.
BARCODE_LOOKUP_OPENFOODFACTS_URL=https://world.openfoodfacts.org/api/v2/product/{code}.json
BARCODE_LOOKUP_UPCITEMDB_URL=https://api.upcitemdb.com/prod/trial/lookup?upc={code}
BARCODE_LOOKUP_OPENBEAUTYFACTS_URL=https://world.openbeautyfacts.org/api/v2/product/{code}.json
BARCODE_LOOKUP_UPCDATABASE_URL=https://api.upcdatabase.org/product/{code}
BARCODE_LOOKUP_JUSTBC_URL=https://www.justbc.com/api/barcode/{code}

# Login abuse protection
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_BLOCK_MS=300000

# Global API rate limiting (per IP)
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=20
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=300

# Optional development seed data. Keep disabled in production.
SEED_DEMO_DATA=false
# SEED_PASSWORD=use-a-local-dev-password-only-when-SEED_DEMO_DATA-is-true

# Super admin password (used only during initial migration)
# SUPERADMIN_PASSWORD=use-a-strong-password-here
