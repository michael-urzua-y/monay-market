# API Backend URL
API_URL=http://api:3000

# Public app URL used only when redirecting from direct dashboard dev port
PUBLIC_APP_URL=http://localhost:8080

# Optional login URL used by the POS when the cashier logs out
# In production, leave empty to use the current public domain.
LOGIN_URL=

# POS URL used when a cashier logs in through the unified login
POS_URL=/pos/

# Use true only when the app is served over HTTPS
POS_AUTH_COOKIE_SECURE=false

# Flask secret key for session management
SECRET_KEY=change-this-secret-in-production

# Flask environment
FLASK_ENV=production
FLASK_DEBUG=0
STRICT_ENV_VALIDATION=false

# Session/cookie security. Use true for SESSION_COOKIE_SECURE in HTTPS production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=43200
MAX_CONTENT_LENGTH=26214400

# Optional directory for uploaded SII certificates
CERT_UPLOAD_DIR=/app/uploads/certificados
